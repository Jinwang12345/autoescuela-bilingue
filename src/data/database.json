      "id": 1,
      "categoria": "Señales de Reglamentación",
      "imagen": "assets/images/senial_r100.png",
      "pregunta": {
        "segmentos": [
          {
            "es": "¿Qué indica esta señal de tráfico",
            "zh": "这个交通标志表示什么"
          },
          {
            "es": " situada a la entrada de una vía?",
            "zh": " 位于道路入口处？"
          }
        ]
      },
      "opciones": [
        {
          "id": "a",
          "texto": {
            "es": "Prohibición de paso a todos los vehículos a motor.",
            "zh": "禁止所有机动车辆通行。"
          },
          "correcta": true
        },
        {
          "id": "b",
          "texto": {
            "es": "Entrada prohibida únicamente a motocicletas.",
            "zh": "仅禁止摩托车进入。"
          },
          "correcta": false
        },
        {
          "id": "c",
          "texto": {
            "es": "Calzada de sentido único obligatoria.",
            "zh": "强制单向行驶车道。"
          },
          "correcta": false
        }
      ],
      "explicacion": {
        "segmentos": [
          {
            "es": "La señal R-100 prohíbe la circulación",
            "zh": "R-100标志禁止车辆通行"
          },
          {
            "es": " a toda clase de vehículos en ambos sentidos.",
            "zh": " 双向禁止所有类型的车辆通行。"
          },
          {
            "es": " Se aplica desde el lugar donde se halla instalada.",
            "zh": " 从其安装位置开始生效。"
          }
        ]
      }
    },
    {
